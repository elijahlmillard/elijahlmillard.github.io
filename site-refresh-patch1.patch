-  margin: 0;
-  padding: 0;
-  width: 100%;
-  flex: 1;
-  display: flex;
-  flex-direction: column;
-}
-
-.film-frame {
-  flex: 1;
-  display: flex;
-  flex-direction: column;
-  align-items: center;
-  justify-content: center;
-  gap: 4px;
-  border-bottom: 1px solid #2a2a2a;
-  cursor: pointer;
-  position: relative;
-  transition: background 0.2s ease;
-}
-
-.film-frame:hover {
-  background: #111;
-}
-
-.film-frame.active {
-  background: #111;
-  outline: 1px solid #a09880;
-  outline-offset: -4px;
-}
-
-.frame-number {
-  font-family: monospace;
-  font-size: 0.5rem;
-  color: #444;
-  letter-spacing: 0.1em;
-}
-
-.frame-label {
-  font-family: monospace;
-  font-size: 0.55rem;
-  color: #a09880;
-  letter-spacing: 0.15em;
-  text-align: center;
-  padding: 0 6px;
-}
-
-.film-frame.active .frame-label {
-  color: #f5f0e8;
-}
-
-/* ============================================================
-   MAIN CONTENT AREA
-   ============================================================ */
-#content-area {
-  position: fixed;
-  left: 130px;
-  top: 0;
-  right: 0;
-  bottom: 0;
-  z-index: 100;
-  display: flex;
-  align-items: center;
-  justify-content: center;
-}
-
-/* ============================================================
-   CONTENT PANELS — only active panel is visible
-   ============================================================ */
-.content-panel {
-  position: absolute;
-  inset: 0;
-  display: none;
-  align-items: flex-start;
-  justify-content: center;
-  padding: 40px 60px;
-}
-
-.content-panel.active {
-  display: flex;
-}
-
-/* ============================================================
-   PANEL INNER — content slides up on reveal
-   ============================================================ */
-.panel-inner {
-  position: relative;
-  z-index: 102;
-  max-width: 700px;
-  width: 100%;
-  opacity: 0;
-  transform: translateY(40px);
-  transition: opacity 0.8s ease, transform 0.8s ease;
-}
-
-.panel-inner.visible {
-  opacity: 1;
-  transform: translateY(0);
-}
-
-.panel-inner h2 {
-  font-family: monospace;
-  font-size: 0.75rem;
-  letter-spacing: 0.4em;
-  color: #a09880;
-  margin-bottom: 32px;
-}
-
-.panel-inner p {
-  font-family: monospace;
-  font-size: 0.95rem;
-  line-height: 1.8;
-  color: #c8b99a;
-  letter-spacing: 0.05em;
-}
-
-/* ============================================================
-   GRAIN CANVAS — sits over everything
-   ============================================================ */
-#filter {
-  position: fixed;
-  inset: 0;
-  z-index: 9999;
-  pointer-events: none;
-  opacity: 0.4;
-}
